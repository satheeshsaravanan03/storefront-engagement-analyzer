# ── Backend Environment Variables ───────────────────────────
# Set these in Railway dashboard under Variables tab

# Port (Railway sets this automatically)
PORT=8000

# Your own deployed backend URL (used to build download links in responses)
BACKEND_URL=https://your-app-name.railway.app

# SerpAPI key (https://serpapi.com) for the snapshot lookup.
SERPAPI_KEY=
# Public address Google Lens uses to fetch snapshots (e.g. a cloudflared/ngrok tunnel URL
# when running locally). Falls back to BACKEND_URL when empty.
PUBLIC_URL=

# Where to store output files (Railway ephemeral disk)
OUTPUT_DIR=/tmp/crowdvision_output
